@using ControleCurriculo.Models
@using System.Linq
@model CurriculoViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Currículo - @Model.Nome</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: #f0f2f5;
            padding: 40px 0;
        }

        .curriculo {
            max-width: 800px;
            margin: 0 auto;
            background: #fff;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
            border-radius: 8px;
            overflow: hidden;
        }

        .cabecalho {
            background-color: #2c3e50;
            color: #fff;
            padding: 30px 40px;
        }

            .cabecalho h1 {
                font-size: 28px;
                margin-bottom: 5px;
            }

            .cabecalho p {
                font-size: 15px;
                color: #bdc3c7;
            }

        .conteudo {
            padding: 30px 40px;
        }

        .secao {
            margin-bottom: 25px;
        }

            .secao h2 {
                font-size: 18px;
                color: #2c3e50;
                border-bottom: 2px solid #2c3e50;
                padding-bottom: 6px;
                margin-bottom: 12px;
            }

        .dados-pessoais {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px 20px;
        }

            .dados-pessoais div {
                font-size: 14px;
            }

            .dados-pessoais strong {
                color: #2c3e50;
            }

        .item {
            margin-bottom: 12px;
            padding-left: 10px;
            border-left: 3px solid #2c3e50;
        }

            .item .titulo {
                font-weight: bold;
                font-size: 15px;
                color: #2c3e50;
            }

            .item .subtitulo {
                font-size: 13px;
                color: #7f8c8d;
                margin-bottom: 4px;
            }

            .item .descricao {
                font-size: 13px;
                color: #34495e;
            }

        .idiomas-lista {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .idioma-badge {
            background-color: #ecf0f1;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 13px;
            color: #2c3e50;
        }

        .voltar {
            display: inline-block;
            margin: 20px auto 0;
            text-align: center;
            width: 100%;
        }

            .voltar a {
                color: #2c3e50;
                text-decoration: none;
                font-size: 14px;
            }

        @@media print {
            .voltar {
                display: none;
            }
        }
    </style>
</head>
<body>

    <div class="curriculo">

        <div class="cabecalho">
            <h1>@Model.Nome</h1>
            <p>@Model.CargoPretendido</p>
        </div>

        <div class="conteudo">

            <div class="secao">
                <h2>Dados Pessoais</h2>
                <div class="dados-pessoais">
                    <div><strong>CPF:</strong> @Model.Cpf</div>
                    <div><strong>Telefone:</strong> @Model.Telefone</div>
                    <div><strong>E-mail:</strong> @Model.Email</div>
                    <div><strong>Endereço:</strong> @Model.Endereco</div>
                    @if (Model.PretensaoSalarial != null)
                    {
                        <div><strong>Pretensão Salarial:</strong> R$ @Model.PretensaoSalarial?.ToString("0.00")</div>
                    }
                </div>
            </div>

            <div class="secao">
                <h2>Formação Acadêmica</h2>
                @foreach (var formacao in Model.Formacoes)
                {
                    <div class="item">
                        <div class="titulo">@formacao.Curso</div>
                        <div class="subtitulo">
                            @formacao.Instituicao
                            @if (formacao.AnoConclusao != null)
                            {
                                <text> — Conclusão: @formacao.AnoConclusao</text>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (Model.Experiencias.Any(e => !string.IsNullOrEmpty(e.Empresa)))
            {
                <div class="secao">
                    <h2>Experiência Profissional</h2>
                    @foreach (var exp in Model.Experiencias.Where(e => !string.IsNullOrEmpty(e.Empresa)))
                    {
                        <div class="item">
                            <div class="titulo">@exp.Cargo — @exp.Empresa</div>
                            <div class="subtitulo">@exp.Periodo</div>
                            <div class="descricao">@exp.Descricao</div>
                        </div>
                    }
                </div>
            }

            @if (Model.Idiomas.Any(i => !string.IsNullOrEmpty(i.Nome)))
            {
                <div class="secao">
                    <h2>Idiomas</h2>
                    <div class="idiomas-lista">
                        @foreach (var idioma in Model.Idiomas.Where(i => !string.IsNullOrEmpty(i.Nome)))
                        {
                            <span class="idioma-badge">@idioma.Nome — @idioma.Nivel</span>
                        }
                    </div>
                </div>
            }

        </div>
    </div>

    <div class="voltar">
        <a href="/curriculo">← Voltar para a listagem</a>
    </div>

</body>
</html>